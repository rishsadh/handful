# --- credentials: never commit ---
kaggle.json
.kaggle/
*.pem
*.key
.env
.env.*

# --- raw + derived data: never commit ---
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/quarantine/

# review text must never leave the machine
*_reviews.parquet
*_review_text.*

# --- model + embedding caches ---
.cache/
cache/
models_cache/
*.npy
*.npz
!tests/fixtures/**/*.npy

# --- run outputs (large; regenerate from a run id) ---
runs/*
!runs/.gitkeep

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- the demo export carries real recipe rows ---
# The dataset licence grants no redistribution rights (D-021), so the extract is
# generated by scripts/export_demo.py and deployed straight to Netlify. It is never
# committed, not even to a private repo.
site/demo/data.json

# --- netlify cli state (machine-specific absolute paths) ---
.netlify/

# --- os ---
Thumbs.db
.DS_Store

# D-021 / D-027: the demo extract and the Food.com recipe photographs are served from the
# local site directory at deploy time and never committed. The manifests (source URLs,
# attribution) and the openly licensed stock photographs are committed.
site/assets/data.json
site/img/recipes/*.jpg
